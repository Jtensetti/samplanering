{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samplanering-local-tests",
  "main": "tests/pilot/worker.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./.pilot-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "demo-planner-tensetti",
    "FIREBASE_API_KEY": "test-key",
    "GOOGLE_LOGIN": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "Workspace"
      },
      {
        "name": "DIRECTORIES",
        "class_name": "UserDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Workspace", "UserDirectory"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES"
    }
  ],
  "observability": {
    "enabled": false
  }
}
