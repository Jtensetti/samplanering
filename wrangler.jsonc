{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planner-tensetti",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "planner-tensetti",
    "GOOGLE_LOGIN": "false",
    "TIME_ZONE": "Europe/Stockholm",
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "Workspace" },
      { "name": "DIRECTORIES", "class_name": "UserDirectory" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace", "UserDirectory"] },
  ],
  "kv_namespaces": [{ "binding": "FILES" }],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
}
