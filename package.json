{
  "name": "samplanering",
  "version": "1.0.0",
  "description": "Gemensam planering med uppgifter, arbetsdokument och uppföljning",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "node --check server/app.mjs && node --check server/workspace.mjs && node --check server/schema.mjs && node --check worker/index.mjs && node --check worker/objects.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pilot": "vite build --mode pilot",
    "dev:pilot": "wrangler dev",
    "deploy:pilot": "node scripts/deploy-pilot.mjs",
    "check:pilot": "wrangler deploy --dry-run",
    "test:worker": "vitest run --config vitest.worker.config.mjs",
    "test:pilot:ui": "playwright test --config playwright.pilot.config.mjs",
    "build:pilot:test": "vite build --mode pilot-test --outDir .pilot-dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jtensetti/samplanering.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Jtensetti/samplanering/issues"
  },
  "homepage": "https://github.com/Jtensetti/samplanering#readme",
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase": "12.19.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "15.32.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "vite": "8.3.1",
    "vitest": "4.1.0",
    "wrangler": "4.143.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
